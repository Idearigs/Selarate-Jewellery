{
  "name": "jewelry-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "user": "tsx scripts/create-user.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "worker": "tsx worker/index.ts",
    "push:keys": "node scripts/vapid-keys.mjs",
    "icons": "node scripts/make-icons.mjs",
    "holds:release": "tsx scripts/release-orphan-holds.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "nodemailer": "^9.0.4",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
