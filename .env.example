# Copy to .env and fill in. lib/env.ts validates this at boot.

# Canonical origin — feeds sitemap.xml, canonical tags, OG images and JSON-LD.
# Getting this wrong is an SEO bug, not a config nit.
SITE_URL=http://localhost:3000

# Postgres. Required in production.
#
# For local dev you do NOT need Docker or a Postgres install: run
#   npm run db:dev
# in a second terminal. That starts PGlite (real Postgres, WASM) behind a
# Postgres socket on :5433, which the app connects to by default when
# DATABASE_URL is unset.
# DATABASE_URL=postgres://jewelry:jewelry@localhost:5432/jewelry

# Object storage for photography (MinIO in production).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=pieces
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=http://localhost:9000/pieces

# Auth — generate with: openssl rand -base64 32
# AUTH_SECRET=

# Payments (US / USD)
#
# The gateway is still an open decision. Leaving these unset is fine: checkout
# works via bank wire, which needs no credentials. Set BOTH to enable the card
# path — the checkout page picks it up automatically.
#
# Webhook endpoint: POST {SITE_URL}/api/payments/webhook/stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional email
# SMTP_URL=smtp://user:pass@host:587
# MAIL_FROM=studio@example.com

# ---------------------------------------------------------------------------
# Web Push — phone alerts for live chat and visitor arrivals.
#
# Generate a pair with `npm run push:keys`. Optional: with these unset chat
# still works in the browser, only the notifications go quiet.
#
# Keep the pair STABLE. The public key is stored inside every subscription the
# browsers already hold, so rotating it invalidates every registered device
# silently — the owner's phone just stops ringing, with no error anywhere.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:studio@example.com
